# Signal Desk environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.

# --- Market data ------------------------------------------------------------
# Twelve Data API key (server-only). Leave empty and the app shows
# "Live data unavailable" and never produces live signals.
TWELVEDATA_API_KEY=

# Synthetic SAMPLE-* data for development and demos. It is always labelled
# synthetic and never produces a tradable signal. Set to false in production
# if you do not want it listed.
ENABLE_SAMPLE_PROVIDER=true

# --- Accounts and saved history (Supabase) ---------------------------------
# Public project URL and anon key. These are designed to be public; row-level
# security in supabase/migrations is what protects each user's data.
# The service-role key is NOT used by this app — do not add it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Abuse protection --------------------------------------------------------
# Requests per minute per client IP for /api/analyze (other routes have fixed limits).
RATE_LIMIT_PER_MINUTE=30
